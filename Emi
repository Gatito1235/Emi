<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Para Emily 💌</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;900&family=Caveat:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#F7EDE2;
    --paper:#FBF4EA;
    --burgundy:#5B2333;
    --burgundy-deep:#3E1826;
    --rose:#D98A86;
    --gold:#C0A062;
    --ink:#3A2E2C;
    --sage:#8B9D83;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Cormorant Garamond', serif;
    background:var(--cream);
    color:var(--ink);
    overflow-x:hidden;
  }
  h1,h2,h3{font-family:'Playfair Display', serif;}
  .script{font-family:'Caveat', cursive;}

  /* ---------- ENVELOPE OVERLAY ---------- */
  #envelope-overlay{
    position:fixed; inset:0; z-index:999;
    background:radial-gradient(circle at 50% 40%, var(--burgundy) 0%, var(--burgundy-deep) 100%);
    display:flex; align-items:center; justify-content:center;
    transition:opacity 1s ease, visibility 1s ease;
  }
  #envelope-overlay.hidden{opacity:0; visibility:hidden; pointer-events:none;}
  .envelope{
    position:relative; width:min(320px, 80vw); height:210px;
    cursor:pointer;
    filter:drop-shadow(0 20px 40px rgba(0,0,0,.4));
  }
  .envelope-body{
    position:absolute; inset:0;
    background:var(--paper);
    border-radius:6px;
  }
  .envelope-flap{
    position:absolute; top:0; left:0; width:100%; height:50%;
    background:var(--rose);
    clip-path:polygon(0 0, 100% 0, 50% 100%);
    transform-origin:top;
    transition:transform .7s cubic-bezier(.6,-0.28,.74,.05);
    z-index:3;
  }
  .envelope.opened .envelope-flap{ transform:rotateX(180deg); }
  .seal{
    position:absolute; top:50%; left:50%;
    width:64px; height:64px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #d1a24a, var(--gold) 70%);
    transform:translate(-50%,-50%);
    display:flex; align-items:center; justify-content:center;
    font-family:'Playfair Display', serif; font-weight:700; font-size:1.6rem; color:var(--burgundy-deep);
    box-shadow:0 4px 10px rgba(0,0,0,.35), inset 0 2px 3px rgba(255,255,255,.4);
    z-index:4;
    transition:transform .5s ease, opacity .5s ease;
  }
  .envelope.opened .seal{ transform:translate(-50%,-50%) scale(0) rotate(35deg); opacity:0; }
  .envelope-caption{
    position:absolute; bottom:-3rem; left:50%; transform:translateX(-50%);
    color:var(--cream); text-align:center; font-family:'Caveat', cursive; font-size:1.5rem; white-space:nowrap;
  }

  /* ---------- MAIN CONTENT ---------- */
  #main-content{ overflow:hidden; }

  section{ padding:6rem 1.5rem; position:relative; }

  /* HERO */
  .hero{
    min-height:100vh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; position:relative;
    background:linear-gradient(180deg, var(--cream) 0%, #f1e2d4 100%);
  }
  .hero .eyebrow{
    letter-spacing:.35em; text-transform:uppercase; font-family:'Cormorant Garamond',serif;
    font-size:.85rem; color:var(--rose); margin-bottom:1.2rem;
  }
  .hero h1{
    font-size:clamp(2.6rem, 8vw, 5.2rem); color:var(--burgundy); line-height:1.05;
  }
  .hero .script-line{
    font-family:'Caveat', cursive; font-size:clamp(1.6rem, 4vw, 2.4rem); color:var(--gold); margin-top:.6rem;
  }
  .counter{
    margin-top:3rem; display:flex; gap:1.4rem; flex-wrap:wrap; justify-content:center;
  }
  .counter .box{
    background:var(--paper); border:1px solid rgba(91,35,51,.15); border-radius:12px;
    padding:1rem 1.4rem; min-width:90px;
    box-shadow:0 8px 20px rgba(91,35,51,.08);
  }
  .counter .num{ font-family:'Playfair Display',serif; font-size:2.1rem; color:var(--burgundy); font-weight:700; }
  .counter .lbl{ font-size:.85rem; letter-spacing:.12em; text-transform:uppercase; color:var(--sage); }

  .petal{ position:absolute; top:-5%; font-size:1.4rem; opacity:.7; animation:fall linear infinite; color:var(--rose); }
  @keyframes fall{
    to{ transform:translateY(115vh) rotate(300deg); opacity:0; }
  }

  /* MOMENTS */
  .section-title{ text-align:center; margin-bottom:.6rem; color:var(--burgundy); font-size:clamp(2rem,5vw,2.8rem); }
  .section-sub{ text-align:center; color:var(--ink); opacity:.75; max-width:560px; margin:0 auto 3.2rem; font-size:1.2rem; }

  .moments{ background:var(--paper); }
  .moments-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:1.6rem; max-width:1000px; margin:0 auto;
  }
  .moment-card{
    background:var(--cream); border-radius:16px; padding:2rem 1.6rem;
    text-align:center; box-shadow:0 10px 26px rgba(91,35,51,.08);
    border:1px solid rgba(192,160,98,.25);
    transition:transform .35s ease, box-shadow .35s ease;
  }
  .moment-card:hover{ transform:translateY(-6px); box-shadow:0 16px 34px rgba(91,35,51,.16); }
  .moment-card .icon{ font-size:2.2rem; margin-bottom:.8rem; display:block; }
  .moment-card h3{ color:var(--burgundy); font-size:1.4rem; margin-bottom:.4rem; }
  .moment-card p{ font-size:1.05rem; color:var(--ink); opacity:.85; }

  /* REASONS - flip cards */
  .reasons-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:1.6rem; max-width:1000px; margin:0 auto; perspective:1200px;
  }
  .flip-card{ height:200px; }
  .flip-inner{
    position:relative; width:100%; height:100%; text-align:center;
    transition:transform .7s; transform-style:preserve-3d; cursor:pointer;
  }
  .flip-card.flipped .flip-inner{ transform:rotateY(180deg); }
  .flip-front,.flip-back{
    position:absolute; inset:0; backface-visibility:hidden;
    border-radius:16px; display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:1.4rem;
  }
  .flip-front{ background:var(--burgundy); color:var(--cream); }
  .flip-front span{ font-family:'Caveat',cursive; font-size:1.5rem; }
  .flip-back{ background:var(--gold); color:var(--burgundy-deep); transform:rotateY(180deg); font-size:1.1rem; }

  /* GALLERY */
  .gallery{ background:linear-gradient(180deg,#f1e2d4 0%, var(--cream) 100%); }
  .gallery-grid{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:1rem; max-width:1000px; margin:0 auto;
  }
  .gallery-item{
    aspect-ratio:3/4; border-radius:14px; position:relative; overflow:hidden;
    display:flex; align-items:flex-end; padding:.9rem;
    box-shadow:0 10px 24px rgba(91,35,51,.12);
    border:3px solid var(--paper);
    outline:1px solid rgba(192,160,98,.4);
    transition:transform .35s ease, box-shadow .35s ease;
  }
  .gallery-item:hover{ transform:translateY(-6px) rotate(-.5deg); box-shadow:0 18px 34px rgba(91,35,51,.2); }
  .gallery-item img{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
  }
  .gallery-item::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(58,46,44,.65) 100%);
  }
  .gallery-item span{
    position:relative; z-index:2;
    color:#fff; font-family:'Caveat', cursive; font-size:1.3rem; padding:.2rem .3rem;
  }
  .gallery-note{ text-align:center; margin-top:2rem; font-size:1rem; color:var(--ink); opacity:.6; }

  /* LETTER */
  .letter-wrap{ display:flex; justify-content:center; }
  .letter{
    max-width:640px; width:100%; background:var(--paper);
    padding:3rem 2.4rem; border-radius:4px;
    box-shadow:0 20px 50px rgba(91,35,51,.18);
    position:relative;
  }
  .letter::before{
    content:""; position:absolute; inset:14px; border:1px solid rgba(192,160,98,.4); border-radius:2px; pointer-events:none;
  }
  .letter p{ font-size:1.25rem; line-height:1.75; margin-bottom:1.1rem; color:var(--ink); }
  .letter .sign{ font-family:'Caveat',cursive; font-size:2rem; color:var(--burgundy); text-align:right; margin-top:1.6rem; }

  footer{
    text-align:center; padding:3rem 1.5rem 3.5rem; color:var(--burgundy); font-family:'Caveat',cursive; font-size:1.3rem;
    background:var(--paper);
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation:none !important; transition:none !important; }
  }
</style>
</head>
<body>

  <!-- Pantalla de sobre: se abre al hacer clic -->
  <div id="envelope-overlay">
    <div class="envelope" id="envelope">
      <div class="envelope-body"></div>
      <div class="envelope-flap"></div>
      <div class="seal">E</div>
      <div class="envelope-caption">toca el sello para abrir 💌</div>
    </div>
  </div>

  <div id="main-content">

    <!-- HERO -->
    <section class="hero" id="hero">
      <div class="eyebrow">para</div>
      <h1>Emily</h1>
      <div class="script-line">dos meses de nosotros, y contando</div>

      <div class="counter" id="counter">
        <div class="box"><div class="num" id="c-days">00</div><div class="lbl">días</div></div>
        <div class="box"><div class="num" id="c-hours">00</div><div class="lbl">horas</div></div>
        <div class="box"><div class="num" id="c-min">00</div><div class="lbl">min</div></div>
        <div class="box"><div class="num" id="c-sec">00</div><div class="lbl">seg</div></div>
      </div>
    </section>

    <!-- MOMENTOS -->
    <section class="moments">
      <h2 class="section-title">Nuestros primeros meses</h2>
      <p class="section-sub">Apenas es el comienzo, pero cada semana ya se siente como un recuerdo que quiero guardar.</p>
      <div class="moments-grid">
        <div class="moment-card">
          <span class="icon">🌱</span>
          <h3>El primer mes</h3>
          <p>Aprendiendo tus gestos, tu risa, la forma en la que dices las cosas sin darte cuenta.</p>
        </div>
        <div class="moment-card">
          <span class="icon">☕</span>
          <h3>Nuestras rutinas</h3>
          <p>Los mensajes de buenos días, las llamadas hasta tarde, los planes pequeños que ya se sienten importantes.</p>
        </div>
        <div class="moment-card">
          <span class="icon">🌙</span>
          <h3>El segundo mes</h3>
          <p>Sintiendo que ya te conozco, y queriendo conocerte todavía más.</p>
        </div>
        <div class="moment-card">
          <span class="icon">💫</span>
          <h3>Lo que sigue</h3>
          <p>Todo lo que todavía no vivimos juntos, y que ya quiero vivir contigo.</p>
        </div>
      </div>
    </section>

    <!-- RAZONES -->
    <section class="reasons">
      <h2 class="section-title">Razones (de muchas)</h2>
      <p class="section-sub">Toca cada tarjeta.</p>
      <div class="reasons-grid">
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front"><span>tu risa</span></div>
            <div class="flip-back">Se me contagia incluso cuando no sé de qué te ríes.</div>
          </div>
        </div>
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front"><span>cómo me escuchas</span></div>
            <div class="flip-back">Haces que hasta lo más pequeño que digo se sienta importante.</div>
          </div>
        </div>
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front"><span>tu forma de ser</span></div>
            <div class="flip-back">Eres exactamente tú, sin esfuerzo, y eso es lo que más me gusta.</div>
          </div>
        </div>
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front"><span>los planes tontos</span></div>
            <div class="flip-back">Hasta hacer nada contigo se siente como el mejor plan del día.</div>
          </div>
        </div>
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front"><span>lo fácil que es</span></div>
            <div class="flip-back">Contigo todo fluye, sin complicaciones, sin dudas.</div>
          </div>
        </div>
        <div class="flip-card" onclick="this.classList.toggle('flipped')">
          <div class="flip-inner">
            <div class="flip-front"><span>lo que viene</span></div>
            <div class="flip-back">Porque apenas empezamos, y ya quiero todo lo que sigue.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- GALERIA -->
    <section class="gallery">
      <h2 class="section-title">Así es ella</h2>
      <p class="section-sub">Cada foto tiene algo que amo.</p>
      <div class="gallery-grid">
        <div class="gallery-item"><img src="fotos/foto1.jpg" alt="Emily"><span>esa sonrisa 🤍</span></div>
        <div class="gallery-item"><img src="fotos/foto2.jpg" alt="Emily"><span>esa mirada ✨</span></div>
        <div class="gallery-item"><img src="fotos/foto3.jpg" alt="Emily"><span>tan ella 🍂</span></div>
        <div class="gallery-item"><img src="fotos/foto4.jpg" alt="Emily"><span>siempre creativa 🎨</span></div>
      </div>
    </section>

    <!-- CARTA -->
    <section class="letter-section">
      <div class="letter-wrap">
        <div class="letter">
          <p>Emily,</p>
          <p>Dos meses no suenan a mucho tiempo, pero contigo se han sentido completos: llenos de risas, de mensajes que no quiero dejar de leer, y de ganas de seguir descubriéndote.</p>
          <p>Gracias por darle sentido a estas semanas. Por tu paciencia, tu forma de ser, y por dejarme ser parte de tu día a día.</p>
          <p>Esto es solo el comienzo, y no podría estar más feliz de que sea contigo.</p>
          <div class="sign">con todo mi cariño 💌</div>
        </div>
      </div>
    </section>

    <footer>
      hecho con amor para Emily
    </footer>

  </div>

<script>
  // Abrir el sobre
  const envelope = document.getElementById('envelope');
  const overlay = document.getElementById('envelope-overlay');
  document.body.style.overflow = 'hidden';

  envelope.addEventListener('click', () => {
    if (envelope.classList.contains('opened')) return;
    envelope.classList.add('opened');
    setTimeout(() => {
      overlay.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }, 750);
  });

  // Pétalos decorativos en el hero
  const hero = document.getElementById('hero');
  const petalSymbols = ['♥','✦','❀'];
  for (let i = 0; i < 12; i++) {
    const p = document.createElement('div');
    p.className = 'petal';
    p.textContent = petalSymbols[i % petalSymbols.length];
    p.style.left = Math.random() * 100 + '%';
    p.style.animationDuration = (8 + Math.random() * 8) + 's';
    p.style.animationDelay = (Math.random() * 8) + 's';
    p.style.fontSize = (0.9 + Math.random() * 1.1) + 'rem';
    hero.appendChild(p);
  }

  // Contador en vivo desde el inicio de la relación
  // AJUSTA esta fecha a la fecha real en que empezaron a salir:
  const startDate = new Date('2026-05-26T00:00:00');

  function pad(n){ return String(n).padStart(2,'0'); }

  function updateCounter(){
    const now = new Date();
    let diff = Math.max(0, now - startDate);

    const days = Math.floor(diff / (1000*60*60*24));
    diff -= days * (1000*60*60*24);
    const hours = Math.floor(diff / (1000*60*60));
    diff -= hours * (1000*60*60);
    const mins = Math.floor(diff / (1000*60));
    diff -= mins * (1000*60);
    const secs = Math.floor(diff / 1000);

    document.getElementById('c-days').textContent = pad(days);
    document.getElementById('c-hours').textContent = pad(hours);
    document.getElementById('c-min').textContent = pad(mins);
    document.getElementById('c-sec').textContent = pad(secs);
  }

  updateCounter();
  setInterval(updateCounter, 1000);
</script>
</body>
</html>
